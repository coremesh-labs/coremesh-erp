{{- /* Vertragsübersicht als Excel (XML-Tabelle, SpreadsheetML 2003 – öffnen mit
       Excel oder LibreOffice): ein Blatt je Zeitraum gleicher Konditionen, eine Zeile
       je Kondition mit Mietobjekt, Summen je Mietobjekt und Zeitraum; beim Drucken
       Querformat, Kopfzeile Name, Fußzeile Anschrift. */ -}}
<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
<DocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><Title>{{ xmlEscape .title }}</Title><Author>{{ xmlEscape (default .company.name .company.partner.name) }}</Author></DocumentProperties>
<Styles>
 <Style ss:ID="Default" ss:Name="Normal"><Font ss:FontName="Calibri" ss:Size="10"/></Style>
 <Style ss:ID="title"><Font ss:FontName="Calibri" ss:Size="14" ss:Bold="1"/></Style>
 <Style ss:ID="head"><Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1"/><Interior ss:Color="#DDEBF7" ss:Pattern="Solid"/></Style>
 <Style ss:ID="date"><NumberFormat ss:Format="dd/mm/yyyy"/></Style>
 <Style ss:ID="num"><NumberFormat ss:Format="#,##0.00"/></Style>
 <Style ss:ID="sumlabel"><Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1"/></Style>
 <Style ss:ID="sum"><Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1"/><NumberFormat ss:Format="#,##0.00"/>
  <Borders><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/></Borders></Style>
</Styles>
{{- range .periods }}{{ $p := . }}
<Worksheet ss:Name="{{ xmlEscape .sheet }}">
<Table>
 <Column ss:Width="150"/><Column ss:Width="90"/><Column ss:Width="150"/><Column ss:Width="110"/><Column ss:Width="150"/>
 <Column ss:Width="65"/><Column ss:Width="65"/><Column ss:Width="140"/><Column ss:Width="75"/><Column ss:Width="85"/><Column ss:Width="85"/><Column ss:Width="85"/>
 <Row><Cell ss:StyleID="title"><Data ss:Type="String">{{ xmlEscape $.title }}</Data></Cell></Row>
 <Row><Cell><Data ss:Type="String">{{ xmlEscape $.subtitle }} · Zeitraum {{ fmtDate .from }} – {{ fmtDate .to }} · {{ .contracts }} Verträge</Data></Cell></Row>
 <Row/>
 <Row>{{ range list "Mietobjekt" "Vertrag" "Bezeichnung" "Art" "Partner" "Beginn" "Ende" "Kondition" "Betrag" "Rhythmus" "Einnahmen mtl." "Ausgaben mtl." }}<Cell ss:StyleID="head"><Data ss:Type="String">{{ . }}</Data></Cell>{{ end }}</Row>
{{- range .groups }}{{ $g := . }}
{{- range .contracts }}{{ $c := . }}
{{- range .conditions }}
 <Row>
  <Cell><Data ss:Type="String">{{ xmlEscape $g.label }}</Data></Cell>
  <Cell><Data ss:Type="String">{{ xmlEscape $c.id }}</Data></Cell>
  <Cell><Data ss:Type="String">{{ xmlEscape $c.designation }}</Data></Cell>
  <Cell><Data ss:Type="String">{{ xmlEscape $c.type_name }}</Data></Cell>
  <Cell><Data ss:Type="String">{{ xmlEscape $c.partner }}</Data></Cell>
  <Cell ss:StyleID="date"><Data ss:Type="DateTime">{{ $c.valid_from }}T00:00:00.000</Data></Cell>
  {{ if $c.open_end }}<Cell/>{{ else }}<Cell ss:StyleID="date"><Data ss:Type="DateTime">{{ $c.valid_to }}T00:00:00.000</Data></Cell>{{ end }}
  <Cell><Data ss:Type="String">{{ xmlEscape .name }}</Data></Cell>
  <Cell ss:StyleID="num"><Data ss:Type="Number">{{ rawNumber .amount }}</Data></Cell>
  <Cell><Data ss:Type="String">{{ xmlEscape .frequency }}</Data></Cell>
  {{ if .monthly_in }}<Cell ss:StyleID="num"><Data ss:Type="Number">{{ rawNumber .monthly_in }}</Data></Cell>{{ else }}<Cell/>{{ end }}
  {{ if .monthly_out }}<Cell ss:StyleID="num"><Data ss:Type="Number">{{ rawNumber .monthly_out }}</Data></Cell>{{ else }}<Cell/>{{ end }}
 </Row>
{{- else }}
 <Row><Cell><Data ss:Type="String">{{ xmlEscape $g.label }}</Data></Cell><Cell><Data ss:Type="String">{{ xmlEscape $c.id }}</Data></Cell>
  <Cell><Data ss:Type="String">{{ xmlEscape $c.designation }}</Data></Cell><Cell><Data ss:Type="String">{{ xmlEscape $c.type_name }}</Data></Cell>
  <Cell><Data ss:Type="String">{{ xmlEscape $c.partner }}</Data></Cell><Cell ss:StyleID="date"><Data ss:Type="DateTime">{{ $c.valid_from }}T00:00:00.000</Data></Cell>
  {{ if $c.open_end }}<Cell/>{{ else }}<Cell ss:StyleID="date"><Data ss:Type="DateTime">{{ $c.valid_to }}T00:00:00.000</Data></Cell>{{ end }}
  <Cell><Data ss:Type="String">keine Konditionen</Data></Cell></Row>
{{- end }}
{{- end }}
 <Row><Cell ss:Index="8" ss:StyleID="sumlabel"><Data ss:Type="String">Summe {{ xmlEscape .label }}</Data></Cell>
  <Cell ss:Index="11" ss:StyleID="sum"><Data ss:Type="Number">{{ rawNumber .monthly_in }}</Data></Cell><Cell ss:StyleID="sum"><Data ss:Type="Number">{{ rawNumber .monthly_out }}</Data></Cell></Row>
 <Row/>
{{- end }}
 <Row><Cell ss:Index="8" ss:StyleID="sumlabel"><Data ss:Type="String">Summe Zeitraum</Data></Cell>
  <Cell ss:Index="11" ss:StyleID="sum"><Data ss:Type="Number">{{ rawNumber .monthly_in }}</Data></Cell><Cell ss:StyleID="sum"><Data ss:Type="Number">{{ rawNumber .monthly_out }}</Data></Cell></Row>
</Table>
<WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
 <PageSetup><Layout x:Orientation="Landscape"/>
  <Header x:Margin="0.3" x:Data="&amp;L{{ xmlEscape (default $.company.name $.company.partner.name) }}&amp;R{{ xmlEscape $.title }}"/>
  <Footer x:Margin="0.3" x:Data="&amp;LSeite &amp;P von &amp;N&amp;R{{ with $.company.partner }}{{ xmlEscape .street }}, {{ xmlEscape .zip }} {{ xmlEscape .city }}{{ end }}"/></PageSetup>
 <FitToPage/><Print><FitWidth>1</FitWidth><FitHeight>0</FitHeight><ValidPrinterInfo/><PaperSizeIndex>9</PaperSizeIndex></Print>
 <FreezePanes/><FrozenNoSplit/><SplitHorizontal>4</SplitHorizontal><TopRowBottomPane>4</TopRowBottomPane><ActivePane>2</ActivePane>
</WorksheetOptions>
</Worksheet>
{{- else }}
<Worksheet ss:Name="Übersicht"><Table><Row><Cell><Data ss:Type="String">Keine laufenden Verträge im Zeitraum.</Data></Cell></Row></Table></Worksheet>
{{- end }}
</Workbook>
